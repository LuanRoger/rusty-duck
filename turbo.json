{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["./dist/**"]
    },
    "app#build": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "app#dev": {
      "dependsOn": ["app#build", "web#build"],
      "persistent": true,
      "cache": false
    }
  }
}
