---
import SearchIcon from "../assets/icons/search.svg";
---

<form class="flex flex-row" action="https://search.luanroger.dev" method="GET">
    <div class="join">
        <label class="input join-item" for="search-input">
            <SearchIcon />
            <input type="text" id="search-input" name="q" required />
        </label>
        <button type="submit" class="btn join-item">
            GO
        </button>
    </div>
</form>
